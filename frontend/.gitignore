# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.bak

# Local demonstration footage (keep large videos out of Git history)
/public/videos/*.mp4
/public/videos/*.mov
/public/videos/*.mkv
/public/videos/*.avi
